# ============================================================
# 로컬 개발용 설정 예시
# 1) 이 파일을 복사해 같은 폴더에 application-local.properties 로 저장
# 2) 아래 비밀번호(필요하면 포트)를 본인 환경에 맞게 수정
# application-local.properties 는 .gitignore 대상이라 Git에 올라가지 않습니다.
# ============================================================

# --- DB (본인 PC의 MySQL) ---
spring.datasource.url=jdbc:mysql://localhost:3306/spoit?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}

# --- 개발 편의 ---
# 템플릿 수정 시 서버 재시작 없이 반영
spring.thymeleaf.cache=false

# MyBatis 실행 SQL 로그 확인 (패키지명은 프로젝트에 맞게 수정)
# logging.level.패키지명.mapper=DEBUG
