# 선택 설정: application-local.properties로 복사한 뒤 local 프로필을 활성화해야 적용됩니다.
# 환경 변수 참조를 유지하거나, 무시 대상 로컬 파일에서만 본인 DB 계정 값을 설정하세요.

# --- DB (본인 PC의 MySQL) ---
spring.datasource.url=jdbc:mysql://localhost:3306/spoit?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}

# 개발 편의: 템플릿 수정 즉시 반영
spring.thymeleaf.cache=false

# 필요 시 MyBatis SQL 로그 활성화
# logging.level.패키지명.mapper=DEBUG
