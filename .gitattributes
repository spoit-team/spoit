# 텍스트 파일 줄바꿈 자동 처리 (Windows/Mac 팀원 간 차이 방지)
* text=auto

# Linux(GitHub Actions, Docker)에서 실행되는 스크립트는 항상 LF
gradlew text eol=lf
*.sh    text eol=lf

# Windows 배치 파일은 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 바이너리 파일은 변환하지 않음
*.jar   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
